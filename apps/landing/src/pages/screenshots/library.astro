---
import '../../styles.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wovenleaf — Library screenshot</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main aria-label="Full-size library screenshot">
      <img
        class="library-screen"
        src="/screenshots/library.jpg"
        alt="Wovenleaf mobile library with reading shelves, book covers, and progress."
        width="376"
        height="844"
      />
    </main>
  </body>
</html>

<style>
  main {
    min-height: 100svh;
    display: grid;
    place-items: center;
  }
  img {
    width: 376px;
  }
</style>
