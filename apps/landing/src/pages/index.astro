---
import playerImage from '../../../../branding/marketing/screenshots/03-audiobook.jpg';
import '@fontsource-variable/literata';
import '@fontsource-variable/ibm-plex-sans';
import '../styles.css';
import StoreLinks from '../components/StoreLinks.astro';
const stories = [
  {
    id: 'track',
    number: '01',
    label: 'THE BOOK TRACKER',
    title: 'Less organizing.\nMore reading.',
    text: 'Keep the books you want to read, the ones you’re reading, and the ones you loved together. Four simple shelves. A clear next chapter.',
    image: '/screenshots/library.jpg',
    width: 390,
    height: 844,
    alt: 'Wovenleaf mobile library showing reading shelves, book covers, and progress.',
    details: [
      'To be read → Up next → Reading → Finished',
      'Page progress, personal ratings, and private notes',
      'Save recommendations and choose what comes next',
    ],
  },
  {
    id: 'read',
    number: '02',
    label: 'THE EPUB READER',
    title: 'A little room\nfor a good book.',
    text: 'Open your EPUBs right where your reading life lives. Settle into a quiet page, find your place, and make the reading room your own.',
    image: '/screenshots/reader.jpg',
    width: 973,
    height: 2048,
    alt: 'Wovenleaf mobile EPUB reader displaying The Shape of Falling, with typography and reading progress controls.',
    details: [
      'Attach your own EPUBs to the books in your library',
      'Comfortable type and paper-inspired themes',
      'Read on iOS and Android, with your files on your device',
    ],
  },
  {
    id: 'listen',
    number: '03',
    label: 'THE AUDIOBOOK PLAYER',
    title: 'Let the story\ncome along.',
    text: 'Bring your audiobooks into the same library. Press play, pick your pace, and keep the story with you when your hands are busy.',
    image: playerImage.src,
    width: 376,
    height: 844,
    alt: 'Wovenleaf mobile audiobook player showing Pride and Prejudice at 43% progress, with playback controls, bookmarks, and notes.',
    details: [
      'M4B or an ordered set of MP3 files',
      'Playback controls, speed, and a sleep timer',
      'Save a bookmark or a private note as you listen',
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wovenleaf — Track, read, listen. One quiet place.</title>
    <meta
      name="description"
      content="A fast, simple book tracker, EPUB reader, and audiobook player. Your whole reading life, together in Wovenleaf."
    />
    <meta name="theme-color" content="#f6f3eb" />
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav wrap">
      <a class="brand" href="#" aria-label="Wovenleaf home"
        ><img src="/mark.svg" width="36" height="36" alt="" />Wovenleaf</a
      >
      <nav aria-label="Main navigation">
        <a href="#track">Track</a><a href="#read">Read</a><a href="#listen"
          >Listen</a
        >
      </nav>
      <StoreLinks compact />
    </header>
    <main id="main">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="dot"></span> YOUR WHOLE READING LIFE
          </p>
          <h1>One place.<br />Every <em>chapter.</em></h1>
          <p class="lead">
            A fast, simple book tracker, EPUB reader, and audiobook player.
            Together, at last.
          </p>
          <StoreLinks />
          <p class="small-note">Made for iOS and Android. No account needed.</p>
        </div>
        <div class="hero-art">
          <span class="annotation">A quieter kind of all-in-one.</span>
          <div class="screen-frame">
            <img
              class="library-screen"
              src="/screenshots/library.jpg"
              alt="Wovenleaf’s book tracker with four shelves, reading progress, ratings, and complete book covers."
              width="390"
              height="844"
              fetchpriority="high"
            />
          </div>
          <span class="art-caption"
            ><span>BOOKS, BEAUTIFULLY TOGETHER</span><span>01 — 03</span></span
          >
        </div>
      </section>
      <div class="intro-strip wrap">
        <p>Less switching.<br /><strong>More story.</strong></p><p>
          Remember a recommendation. Turn a page. Press play.<br />It all
          belongs in the same quiet place.
        </p><span aria-hidden="true">↓</span>
      </div>
      <div class="stories wrap">
        {
          stories.map((story) => (
            <section
              class:list={['story', { reverse: story.id === 'read' }]}
              id={story.id}
            >
              <a
                class="story-image"
                href={
                  story.id === 'track' ? '/screenshots/library/' : story.image
                }
                target="_blank"
                rel="noopener"
                aria-label={`View the ${story.id} app screenshot full size (opens in a new tab)`}
              >
                <>
                  <img
                    class:list={{ 'library-screen': story.id === 'track' }}
                    src={story.image}
                    alt={story.alt}
                    width={story.width}
                    height={story.height}
                    loading="lazy"
                  />
                  <span>
                    Take a closer look <span aria-hidden="true">↗</span>
                  </span>
                </>
              </a>
              <div class="story-copy">
                <>
                  <p class="eyebrow">
                    <span class="chapter-number">{story.number}</span>
                    {story.label}
                  </p>
                  <h2>
                    {story.title.split('\n').map((line) => (
                      <span>
                        {line}
                        <br />
                      </span>
                    ))}
                  </h2>
                  <p>{story.text}</p>
                  <ul>
                    {story.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                </>
              </div>
            </section>
          ))
        }
      </div>
      <section class="privacy wrap">
        <div class="privacy-mark" aria-hidden="true">✳</div><p class="eyebrow">
          PERSONAL BY NATURE
        </p><h2>Your reading life.<br /><em>Yours to keep.</em></h2><p>
          Your library, files, and private notes stay on your device.<br />No
          account to create. No feed to keep up with.
        </p><div class="privacy-notes">
          <span>Stored on your device</span><span>Portable library backups</span
          ><span>No analytics layer</span>
        </div>
      </section>
      <section class="closing wrap">
        <p class="eyebrow">THE NEXT CHAPTER IS YOURS</p><h2>
          A book tracker.<br />A reader. A player.<br /><em
            >A simpler reading life.</em
          >
        </h2><StoreLinks />
      </section>
    </main>
    <footer class="wrap">
      <a class="brand" href="#"
        ><img src="/mark.svg" width="28" height="28" alt="" />Wovenleaf</a
      ><p>All your reading. One quiet place.</p><a href="#main"
        >Back to the beginning ↑</a
      >
    </footer>
  </body>
</html>
