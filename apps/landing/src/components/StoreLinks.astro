---
import {
  createTranslator,
  localeFromPath,
  type Language,
} from '../localization';
const locale: Language =
  Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = createTranslator(locale);
const { compact = false } = Astro.props;
const stores = [
  {
    name: 'App Store',
    logo: '/store-logos/apple.svg',
    url: import.meta.env.PUBLIC_APP_STORE_URL || 'https://apps.apple.com/',
  },
  {
    name: 'Google Play',
    logo: '/store-logos/google-play.svg',
    url:
      import.meta.env.PUBLIC_GOOGLE_PLAY_URL ||
      'https://play.google.com/store/apps',
  },
];
---

<div
  class:list={['store-links', { compact }]}
  aria-label={t('Coming soon on iOS and Android')}
>
  {
    stores.map((store) => (
      <a
        class="store-link"
        href={store.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t(
          'Wovenleaf is coming soon to {{store}} (opens store in a new tab)',
          { store: store.name },
        )}
      >
        <img
          class="store-logo"
          src={store.logo}
          width="28"
          height="28"
          alt=""
          aria-hidden="true"
        />
        <span class="store-link-copy">
          <>
            <small set:html={t('Coming soon to')} />
            <strong>{store.name}</strong>
          </>
        </span>
      </a>
    ))
  }
</div>
