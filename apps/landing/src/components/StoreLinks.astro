---
import {
  createTranslator,
  localeFromPath,
  type Language,
} from '../localization';
const locale: Language =
  Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const t = createTranslator(locale);
const { compact = false } = Astro.props;
const links = [
  { name: t('Source code'), url: 'https://github.com/hmrguez/BookManager' },
  {
    name: t('Build and install'),
    url: 'https://github.com/hmrguez/BookManager/blob/main/docs/guides/community-builds.md',
  },
];
---

<div
  class:list={['store-links', { compact }]}
  aria-label={t('Free and open source')}
>
  {
    links.map((link) => (
      <a
        class="store-link"
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          class="store-logo"
          src="/mark.svg"
          width="28"
          height="28"
          alt=""
          aria-hidden="true"
        />
        <span class="store-link-copy">
          <>
            <small>{t('Free and open source')}</small>
            <strong>{link.name}</strong>
          </>
        </span>
      </a>
    ))
  }
</div>
