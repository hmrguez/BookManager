{
  "manifest_version": 3,
  "name": "Wovenleaf \u00b7 Libby progress",
  "version": "0.6.0",
  "description": "Bring your Libby web books and reading progress to Wovenleaf. Private and local.",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://libbyapp.com/*",
    "https://*.listen.overdrive.com/*",
    "https://*.listen.libbyapp.com/*",
    "https://*.read.libbyapp.com/*",
    "https://*.read.overdrive.com/*"
  ],
  "icons": {
    "192": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wovenleaf \u00b7 Libby"
  },
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://libbyapp.com/*"
      ],
      "js": [
        "common.js",
        "extract.js",
        "player-host.js",
        "observe.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.listen.overdrive.com/*",
        "https://*.listen.libbyapp.com/*",
        "https://*.read.libbyapp.com/*",
        "https://*.read.overdrive.com/*"
      ],
      "js": [
        "common.js",
        "player.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
