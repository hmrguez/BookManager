{
  "manifest_version": 3,
  "name": "Wovenleaf · Libby progress",
  "version": "0.1.0",
  "description": "Bring your visible Libby shelf progress to Wovenleaf. Private, local, and yours to review.",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://libbyapp.com/*"
  ],
  "icons": {
    "192": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wovenleaf · Libby"
  },
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://libbyapp.com/*"
      ],
      "js": [
        "common.js",
        "extract.js",
        "observe.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
