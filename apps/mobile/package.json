{
  "name": "wovenleaf",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gallery": "vite --host 127.0.0.1 --open /__gallery",
    "gallery:test": "playwright test",
    "gallery:update": "playwright test --update-snapshots",
    "build": "bun run typecheck && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "check": "bun run lint && bun run typecheck",
    "test": "bun test ./tests/*.test.ts",
    "preview": "vite preview",
    "assets:generate": "uv run --no-project --with-requirements scripts/brand-assets-requirements.txt scripts/generate-brand-assets.py --source-png ../../branding/source/wovenleaf-mark-color-2048px.png --source-svg ../../branding/source/wovenleaf-mark-color.svg --local-output ../../branding/final/platform",
    "cap:sync": "bun run build && cap sync",
    "cap:doctor": "cap doctor",
    "android:open": "bun run cap:sync && cap open android",
    "android:run": "bun run cap:sync && cap run android",
    "ios:open": "bun run cap:sync && cap open ios",
    "ios:run": "bun run cap:sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "lucide-react": "^1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
