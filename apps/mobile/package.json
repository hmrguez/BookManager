{
  "name": "wovenleaf",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.13",
  "type": "module",
  "scripts": {
    "dev": "node ../libby-extension/build.mjs && vite",
    "gallery": "vite --host 127.0.0.1 --open /__gallery",
    "conflicts": "vite --host 127.0.0.1 --open /__conflicts",
    "gallery:test": "playwright test",
    "gallery:update": "playwright test --update-snapshots",
    "build": "node ../libby-extension/build.mjs && bun run typecheck && vite build",
    "build:dev": "node ../libby-extension/build.mjs && bun run typecheck && vite build --mode development",
    "capacitor:sync:after": "bun scripts/configure-ios-spm.ts",
    "capacitor:update:after": "bun scripts/configure-ios-spm.ts",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "check": "bun run lint && bun run typecheck",
    "test": "bun test ./tests/*.test.ts",
    "storage:inspect": "bun scripts/inspect-storage.ts",
    "review-access": "bun scripts/review-access.ts",
    "review-access:test-native": "bun scripts/test-review-access-native.ts",
    "feedback:generate": "bun scripts/generate-feedback-sounds.ts",
    "preview": "vite preview",
    "assets:generate": "uv run --no-project --with-requirements scripts/brand-assets-requirements.txt scripts/generate-brand-assets.py --source-png ../../branding/source/wovenleaf-mark-color-2048px.png --source-svg ../../branding/source/wovenleaf-mark-color.svg --local-output ../../branding/final/platform",
    "cap:sync": "bun run build && cap sync",
    "cap:sync:dev": "bun run build:dev && cap sync",
    "cap:doctor": "cap doctor",
    "android:open": "bun run cap:sync && cap open android",
    "android:run": "bun run cap:sync && cap run android",
    "android:run:dev": "bun run cap:sync:dev && cap run android",
    "ios:open": "bun run cap:sync && cap open ios",
    "ios:run": "bun run cap:sync && cap run ios",
    "ios:run:dev": "bun run cap:sync:dev && cap run ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "3.1.1",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.0",
    "@capgo/capacitor-share-target": "8.0.49",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xmldom/xmldom": "0.9.12",
    "jeep-sqlite": "2.8.0",
    "jszip": "3.10.1",
    "lucide-react": "^1.33.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql.js": "1.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "oxlint": "1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "overrides": {
    "sql.js": "1.11.0"
  },
  "patchedDependencies": {
    "@capacitor-community/sqlite@8.1.1": "patches/@capacitor-community%2Fsqlite@8.1.1.patch",
    "@capgo/capacitor-share-target@8.0.49": "patches/@capgo%2Fcapacitor-share-target@8.0.49.patch"
  }
}
