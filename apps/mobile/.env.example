# Optional. Enables Google Books as a secondary catalog. Restrict the key to the Books API
# and the app's allowed origins/application identifiers before shipping it.
VITE_GOOGLE_BOOKS_API_KEY=

# Advanced product surfaces. The everyday reading flow keeps these off by default.
VITE_FEATURE_ASSISTED_UP_NEXT=false
VITE_FEATURE_SMART_LISTS=false
VITE_FEATURE_ADVANCED_BOOK_DETAILS=false
VITE_FEATURE_ADVANCED_FILE_MANAGEMENT=false
