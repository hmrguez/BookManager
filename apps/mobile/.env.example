# Advanced product surfaces. The everyday reading flow keeps these off by default.
# Enable only in trusted development builds assembled with `vite build`.
VITE_FEATURE_DEV_TOOLS=false
VITE_FEATURE_SMART_LISTS=false
VITE_FEATURE_ADVANCED_BOOK_DETAILS=false
VITE_FEATURE_ADVANCED_FILE_MANAGEMENT=false

# Set only after publishing the Libby companion to Chrome Web Store or Edge Add-ons.
# The Quetta setup guide shows an installation link only for these HTTPS store hosts.
VITE_LIBBY_EXTENSION_STORE_URL=

# Published Firefox Android companion listing; blank until Mozilla signing/publication.
VITE_LIBBY_FIREFOX_STORE_URL=
