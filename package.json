{
  "name": "bookmanager",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "bun run build && cap sync",
    "cap:doctor": "cap doctor",
    "android:open": "bun run cap:sync && cap open android",
    "android:run": "bun run cap:sync && cap run android",
    "ios:open": "bun run cap:sync && cap open ios",
    "ios:run": "bun run cap:sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "lucide-react": "^1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
